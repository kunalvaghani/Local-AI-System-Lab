{
  "schema_version": 1,
  "release_scope": "single-user loopback local product on the measured RTX 3050 workstation",
  "minimum_backend_tests": 151,
  "minimum_frontend_tests": 39,
  "required_browser_routes": [
    "/runtime",
    "/agents",
    "/scheduler",
    "/hardware",
    "/metrics",
    "/traces",
    "/chaos",
    "/security"
  ],
  "required_failure_statuses": {
    "invalid_task": 400,
    "denied_tool": 403,
    "unconfirmed_chaos": 400,
    "terminal_cancel": 409,
    "missing_task": 404
  },
  "maximum_browser_flow_ms": 120000,
  "maximum_tool_duration_ms": 1000,
  "maximum_javascript_gzip_bytes": 256000
}
